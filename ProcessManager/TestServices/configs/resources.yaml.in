# resources: the CPU and memory figures. They come from the service's cgroup, so they read 0 without cgroups.

Tepegoz:
  Mode: Auto
  LogLevel: Info

Services:
  # About half a core and 64 MB.
  - ProcessName: hog
    ExecutablePath: @PMT_BIN_DIR@/pmt_hog
    Args: [--cpu-percent, 50, --memory-mb, 64]
    StdioMode: Pipe
    GracePeriodMs: 200

  - ProcessName: idle
    ExecutablePath: @PMT_BIN_DIR@/pmt_steady
    Args: [--period-ms, 5000]
    StdioMode: Pipe
    GracePeriodMs: 200
