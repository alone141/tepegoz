# stopping: a service that takes 2 s to stop within its 5 s limit, and one that ignores SIGTERM and gets SIGKILL.
# Then:  tepegoz --kill slow | --kill stubborn

Tepegoz:
  Mode: Auto
  # Debug shows each stop's steps, such as "Graceful shutdown failed" before the SIGKILL.
  LogLevel: Debug

Services:
  - ProcessName: slow
    ExecutablePath: @TPZ_BIN_DIR@/tpz_steady
    Args: [--period-ms, 1000, --stop-delay-ms, 2000]
    StdioMode: Pipe
    GracePeriodMs: 300
    ForceKillTimeoutMs: 5000

  # It and its child ignore SIGTERM; SIGKILL follows after 1.5 s.
  - ProcessName: stubborn
    ExecutablePath: @TPZ_BIN_DIR@/tpz_stubborn
    Args: [--child, --period-ms, 1000]
    StdioMode: Pipe
    GracePeriodMs: 300
    ForceKillTimeoutMs: 1500
