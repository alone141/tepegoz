# environment: arguments, environment variables, the display and the working directory a service starts with.
# Each service prints them once (see the manager's log) and waits.
# 'validate' reports one error here on purpose: cwd_missing's Cwd does not exist.

Tepegoz:
  Mode: Auto
  LogLevel: Info

Services:
  # A list keeps "two words" as one argument.
  - ProcessName: args_list
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    Args: [--show, HOME, two words, plain]
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never

  # A text is split at spaces.
  - ProcessName: args_text
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    Args: --show HOME two words
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never

  - ProcessName: env_vars
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    Args: [--show, TPZ_COLOR, --show, TPZ_EMPTY]
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never
    EnvironmentVariables:
      TPZ_COLOR: blue
      TPZ_EMPTY: ""

  # Starts from an empty environment: only TPZ_ONLY is set.
  - ProcessName: env_cleared
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    Args: [--show, TPZ_ONLY, --all-env]
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never
    InheritParentEnvironment: false
    EnvironmentVariables:
      TPZ_ONLY: this

  - ProcessName: display
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never
    UseDisplay: true
    Display: ":7"
    XAuthority: /tmp/tpz.Xauthority

  - ProcessName: cwd_tmp
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    Cwd: /tmp
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never

  - ProcessName: cwd_missing
    ExecutablePath: @TPZ_BIN_DIR@/tpz_env
    Cwd: /nonexistent/tpz
    StdioMode: Pipe
    GracePeriodMs: 100
    RestartMode: Never
