# Tepegoz configuration, installed by cmake --install. It starts no service yet.
# List your services under Services, or give each one a file in the services.d folder next to this file:
# <ProcessName>.yaml, with the keys of one Services entry. Those come after the ones listed here, in file name order.
# Then check the configuration and have the manager read it again:
#   @INSTALLED_MANAGER@ validate --config @TEPEGOZ_CONFIG_DIR@tepegoz.yaml
#   systemctl reload @UNIT_NAME@
# '@INSTALLED_MANAGER@ generate' writes a template that documents every key.
# To install your own file instead, configure the build with -DTEPEGOZ_CONFIG_SOURCE=/path/to/tepegoz.yaml.

Tepegoz:
  Mode: Auto
  LogLevel: Info
  # true lets any machine that reaches port 6671 register services, which the manager runs as root.
  RemoteRegistration: false

Services: []
