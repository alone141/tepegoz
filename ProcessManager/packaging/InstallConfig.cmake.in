# Run by cmake --install: puts the configuration in @PM_CONFIG_DIR@ unless one is already there. An existing
# configuration is kept, since it may have been edited, and the new one is put next to it as a .new file.
set(source "@config_source@")
# file(INSTALL) puts DESTDIR in front of the directory itself; the checks need it written out.
string(REGEX REPLACE "/+$" "" directory "@PM_CONFIG_DIR@")
set(target "$ENV{DESTDIR}${directory}/ProcessManagerConfig.yaml")

if(NOT EXISTS "${target}")
    file(INSTALL DESTINATION "${directory}" TYPE FILE FILES "${source}" RENAME ProcessManagerConfig.yaml)
    return()
endif()

file(READ "${target}" installed)
file(READ "${source}" packaged)
if(installed STREQUAL packaged)
    message(STATUS "Up-to-date: ${target}")
    return()
endif()

file(INSTALL DESTINATION "${directory}" TYPE FILE FILES "${source}" RENAME ProcessManagerConfig.yaml.new)
message(STATUS "Kept the existing ${target}; the packaged one is ProcessManagerConfig.yaml.new next to it")
