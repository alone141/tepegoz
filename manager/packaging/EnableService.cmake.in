# Run last by cmake --install: enables @UNIT_NAME@, so the manager starts at boot. It does not start it now.
# Skipped for a staged install (DESTDIR), without root, and where systemd is not running.
set(unit "@TEPEGOZ_SYSTEMD_UNIT_DIR@/@UNIT_NAME@")
set(name "@UNIT_NAME@")
set(how "as root: systemctl daemon-reload && systemctl enable ${unit}")
set(enable_as "${unit}")

if(NOT "$ENV{DESTDIR}" STREQUAL "")
    message(STATUS "Staged install: ${name} is not enabled")
    return()
endif()

# The check sd_booted() makes.
if(NOT IS_DIRECTORY "/run/systemd/system")
    message(STATUS "systemd is not running here: ${name} is not enabled")
    return()
endif()

execute_process(COMMAND id -u OUTPUT_VARIABLE uid OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT uid STREQUAL "0")
    message(STATUS "Not installing as root: ${name} is not enabled. Enable it ${how}")
    return()
endif()

# A unit in one of systemd's own directories is enabled by name; one elsewhere (a prefix such as
# /opt/tepegoz) by its full path, which links it into /etc/systemd/system.
set(enable_as "${unit}")
if("@TEPEGOZ_SYSTEMD_UNIT_DIR@" MATCHES "^(/etc|/usr/lib|/lib|/usr/local/lib)/systemd/system/?$")
    set(enable_as "${name}")
endif()

# Before the rename the unit was processmanager.service. With both enabled, two managers would start at boot and
# fight over the same ports, so the switch is left to the operator while the old one is enabled.
execute_process(COMMAND systemctl is-enabled --quiet processmanager.service RESULT_VARIABLE old_unit_disabled)
if(old_unit_disabled EQUAL 0)
    message(WARNING "processmanager.service, this manager's unit before the rename, is still enabled, so ${name} "
                    "is not. Move the configuration first (see the release notes), then switch as root: "
                    "systemctl disable --now processmanager.service && systemctl daemon-reload && "
                    "systemctl enable --now ${enable_as}")
    return()
endif()

execute_process(COMMAND systemctl daemon-reload RESULT_VARIABLE reloaded)
execute_process(COMMAND systemctl enable "${enable_as}" RESULT_VARIABLE enabled ERROR_VARIABLE enable_error)
if(NOT reloaded EQUAL 0 OR NOT enabled EQUAL 0)
    message(WARNING "Could not enable ${name}: ${enable_error}Enable it ${how}")
    return()
endif()

execute_process(COMMAND systemctl is-active --quiet ${name} RESULT_VARIABLE inactive)
if(inactive EQUAL 0)
    message(STATUS "Enabled ${name}. It is running the build from before: systemctl restart ${name}")
else()
    message(STATUS "Enabled ${name}: it starts at boot. Start it now with: systemctl start ${name}")
endif()
