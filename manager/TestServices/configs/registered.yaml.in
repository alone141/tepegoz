# registered: a service that only a file in services.d defines, between two services of this file in the start order.
# The driver copies this config into the scenario's run folder and writes services.d next to it:
#   services.d/registered.yaml   ProcessName: registered, DependsOn: [anchor], no WorkMode (Mode: Auto applies)
#   and files the manager ignores: a dot file, a .txt file and a subfolder.
# Run:   tepegoz --config registered.yaml   (with such a services.d folder next to it)

Tepegoz:
  Mode: Auto
  LogLevel: Info

Services:
  - ProcessName: anchor
    ExecutablePath: @TPZ_BIN_DIR@/tpz_steady
    Args: [--period-ms, 2000]
    StdioMode: Pipe
    GracePeriodMs: 500

  # Depends on registered, which services.d/registered.yaml defines.
  - ProcessName: follower
    ExecutablePath: @TPZ_BIN_DIR@/tpz_steady
    Args: [--period-ms, 2000]
    StdioMode: Pipe
    GracePeriodMs: 500
    DependsOn: [registered]
