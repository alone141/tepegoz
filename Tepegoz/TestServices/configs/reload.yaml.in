# reload: services added, changed, removed and kept by 'tepegoz reload' while the manager runs.
# The driver copies this config into the scenario's run folder and writes services.d next to it:
#   services.d/edited.yaml    tpz_env, which prints TPZ_MARK: one; the driver changes it to two
#   services.d/doomed.yaml    tpz_steady; the driver deletes the file
#   services.d/fragile.yaml   tpz_steady; the driver reformats the file, then breaks it
# and later services.d/added.yaml and services.d/late.yaml, and it breaks this file for a while.
# Run:   tepegoz --config reload.yaml   (with such a services.d folder next to it)

Tepegoz:
  Mode: Auto
  LogLevel: Info

Services:
  - ProcessName: anchor
    ExecutablePath: @TPZ_BIN_DIR@/tpz_steady
    Args: [--period-ms, 2000]
    StdioMode: Pipe
    GracePeriodMs: 500
